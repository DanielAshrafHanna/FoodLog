{
  "name": "restaurant-journal",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "node build.mjs",
    "build:deploy": "node build.mjs",
    "start": "node build.mjs && node server.mjs",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "playwright test",
    "check": "node --check app.js && node --check sw.js && node --check cloudflare-worker.mjs && vitest run",
    "cloudflare:check": "npm run check && npm run build && wrangler deploy --dry-run",
    "cloudflare:deploy": "wrangler deploy"
  },
  "dependencies": {
    "@fontsource-variable/atkinson-hyperlegible-next": "5.3.0",
    "@fontsource-variable/bricolage-grotesque": "5.3.0",
    "@supabase/supabase-js": "2.110.8"
  },
  "devDependencies": {
    "@playwright/test": "1.61.1",
    "axe-core": "4.12.1",
    "jsdom": "27.0.1",
    "supabase": "2.109.1",
    "vitest": "3.2.7",
    "wrangler": "4.129.0"
  }
}
